{
  "name": "chapter-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify:previews": "tsx tools/verify-game-previews.ts",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5190",
    "dev:wishbone": "npm run dev -w @chapter-house/game-wishbone-fling",
    "dev:douse": "npm run dev -w @chapter-house/game-dig-and-douse",
    "dev:keyfall": "npm run dev -w @chapter-house/game-keyfall",
    "dev:arctic": "npm run dev -w @chapter-house/game-arctic-duet",
    "dev:gummy": "npm run dev -w @chapter-house/game-gummy-nook",
    "dev:contraption": "npm run dev -w @chapter-house/game-contraption",
    "dev:bureau": "npm run dev -w @chapter-house/game-bureau-after-dark",
    "dev:stormglide": "npm run dev -w @chapter-house/game-stormglide",
    "dev:moonlight": "npm run dev -w @chapter-house/game-moonlight-munch-run",
    "dev:veda": "npm run dev -w @chapter-house/game-vedas-great-escape",
    "build:wishbone": "npm run build -w @chapter-house/game-wishbone-fling",
    "build:douse": "npm run build -w @chapter-house/game-dig-and-douse",
    "test:wishbone": "npm run test -w @chapter-house/game-wishbone-fling",
    "test:douse": "npm run test -w @chapter-house/game-dig-and-douse"
  },
  "dependencies": {
    "@chapter-house/game-arctic-duet": "*",
    "@chapter-house/game-bureau-after-dark": "*",
    "@chapter-house/game-contraption": "*",
    "@chapter-house/game-dig-and-douse": "*",
    "@chapter-house/game-gummy-nook": "*",
    "@chapter-house/game-host": "*",
    "@chapter-house/game-moonlight-munch-run": "*",
    "@chapter-house/game-keyfall": "*",
    "@chapter-house/game-stormglide": "*",
    "@chapter-house/game-vedas-great-escape": "*",
    "@chapter-house/game-wishbone-fling": "*",
    "firebase": "^12.19.0",
    "matter-js": "0.20.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/matter-js": "0.20.2",
    "@types/node": "26.5.1",
    "@types/three": "0.186.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
